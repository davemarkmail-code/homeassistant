<Application x:Class="XeonDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: the window is only created after the target monitor is
        confirmed to exist. Startup is orchestrated in App.xaml.cs.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Appliance palette. Kept minimal for the foundation. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0D10" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#E6EAF0" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#3DA9FC" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
