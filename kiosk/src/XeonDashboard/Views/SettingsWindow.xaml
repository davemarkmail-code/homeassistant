<Window x:Class="XeonDashboard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XEON Dashboard — Settings"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanMinimize"
        Background="#12151A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EAF0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C4CCD6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="#1C212A" />
            <Setter Property="Foreground" Value="#E6EAF0" />
            <Setter Property="BorderBrush" Value="#2C3440" />
            <Setter Property="CaretBrush" Value="#E6EAF0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EAF0" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="Light" Margin="0,0,0,16" />

        <!-- Friendly scaling notice -->
        <Border Grid.Row="1" Background="#152230" BorderBrush="#24507A" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,20">
            <TextBlock Text="{Binding ScalingNotice}" TextWrapping="Wrap"
                       Foreground="#Bcd6f0" FontSize="12.5" LineHeight="19" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Home Assistant address (IP or hostname)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. 192.168.68.170 or homeassistant.local" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Port" Margin="0,-20,0,4" />
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Default Home Assistant port is 8123" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="Dashboard path" />
                <TextBox Text="{Binding DashboardPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="The bit after the address, e.g. lovelace/0 or davemark-dashboard/work" />

                <CheckBox Content="Kiosk mode — hide the Home Assistant sidebar and header"
                          IsChecked="{Binding KioskMode}" />
                <TextBlock Text="Kiosk mode needs the free 'kiosk-mode' add-on (installed via HACS) in Home Assistant. Without it, the sidebar will still appear."
                           TextWrapping="Wrap" Foreground="#8A94A2" FontSize="11.5" Margin="24,-6,0,12" />
                <CheckBox Content="Use HTTPS (only if your Home Assistant uses it)" IsChecked="{Binding UseHttps}" />

                <Border Background="#101820" BorderBrush="#243244" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,4,0,16">
                    <StackPanel>
                        <TextBlock Text="This will open:" Foreground="#8A94A2" FontSize="11.5" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding ComposedUrl}" Foreground="#7FD4A0"
                                   FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Label}" Text="Display" />
                <ComboBox ItemsSource="{Binding Monitors}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedMonitorValue}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="Launch delay (seconds)" />
                        <TextBox Text="{Binding LaunchDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Reconnect interval (seconds)" />
                        <TextBox Text="{Binding ReconnectIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="WebView profile location (blank = default)" />
                <TextBox Text="{Binding WebViewProfilePath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Where the browser profile (and your saved login) is stored." />

                <CheckBox Content="Keep dashboard always on top" IsChecked="{Binding AlwaysOnTop}" />
                <CheckBox Content="Hide the mouse cursor when idle" IsChecked="{Binding HideMouse}" />
                <CheckBox Content="Start automatically when Windows signs in" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Content="Exit silently if the chosen display isn't found"
                          IsChecked="{Binding ExitSilentlyIfMonitorMissing}"
                          ToolTip="Best for a dedicated appliance. Leave off for a normal PC." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    Width="100" Height="34" Margin="0,0,10,0" />
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Width="120" Height="34" IsDefault="True"
                    Background="#3DA9FC" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
