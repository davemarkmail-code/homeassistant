<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable build: one self-contained .exe with the .NET runtime bundled in.
  Publish from Visual Studio (Publish… > this profile) or:
    dotnet publish src\XeonDashboard\XeonDashboard.csproj /p:PublishProfile=win-x64-single
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Release\net8.0-windows10.0.19041.0\win-x64\portable\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
